.venv/
__pycache__/
*.pyc
.pytest_cache/
# generated data, meshes and checkpoints are rebuilt by scripts, never committed
data/
runs/
*.pt
*.onnx
# never commit body-model files or caches
.cache/
*.pkl
*.npz
# viewer data is regenerated by python -m body3d.change
viewer/data/
# .NET build output; fixtures are regenerated by python -m body3d.export
dotnet/**/bin/
dotnet/**/obj/
dotnet/fixtures/*.stl
dotnet/fixtures/*.f32
dotnet/**/scan-store/
# private notes, not published
docs/private/
# local desktop-app config
.claude/
# parity fixtures (ONNX model, STLs, expected values) are regenerated by python -m body3d.export
dotnet/fixtures/
